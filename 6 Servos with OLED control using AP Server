#include <WiFi.h>
#include <WebServer.h>
#include <SPI.h>
#include <Adafruit_SSD1327.h>
#include <ESP32Servo.h>

// --- OLED SPI Pins ---
#define OLED_SCK   4
#define OLED_MOSI  1
#define OLED_CS    10
#define OLED_DC    8
#define OLED_RST   9

// --- Servo Pins ---
#define SERVO1_PIN  0
#define SERVO2_PIN  2
#define SERVO3_PIN  3
#define SERVO4_PIN  5
#define SERVO5_PIN  6
#define SERVO6_PIN  7

// --- WiFi AP ---
const char* AP_SSID = "OLED_Dashboard";
const char* AP_PASS = "12345678";

// --- Objects ---
Adafruit_SSD1327 display(128, 128, &SPI, OLED_DC, OLED_RST, OLED_CS);
WebServer server(80);
Servo servo[6];
int servoAngles[6] = {90, 90, 90, 90, 90, 90};
String oledText = "";

