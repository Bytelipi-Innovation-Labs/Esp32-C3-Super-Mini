// --- OLED word-wrap ---
void showOnOLED(const String& text) {
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1327_WHITE);

  int x = 0, y = 0;
  const int LINE_H = 12;
  const int CHAR_W = 6;

  String word = "";
  for (int i = 0; i <= text.length(); i++) {
    char c = (i < text.length()) ? text[i] : '\n';
    if (c == ' ' || c == '\n') {
      if (word.length() > 0) {
        int w = word.length() * CHAR_W;
        if (x + w > 128) { x = 0; y += LINE_H; }
        if (y < 128) {
          display.setCursor(x, y);
          display.print(word);
          x += w;
        }
        word = "";
      }
      if (c == '\n') { x = 0; y += LINE_H; }
    } else {
      word += c;
    }
  }
  display.display();
}

// --- Web handlers ---
void handleRoot() {
  server.send(200, "text/html", index_html);
}

void handlePost() {
  // Read servo angles
  for (int i = 0; i < 6; i++) {
    String key = "s" + String(i + 1);
    if (server.hasArg(key)) {
      int angle = constrain(server.arg(key).toInt(), 0, 180);
      if (angle != servoAngles[i]) {
        servoAngles[i] = angle;
        servo[i].write(angle);
      }
    }
  }

  // Read OLED text
  if (server.hasArg("text")) {
    oledText = server.arg("text");
    showOnOLED(oledText);
  }

  server.send(200, "text/html", index_html);
}

void setup() {
  Serial.begin(115200);
  delay(1000);

  // OLED
  SPI.begin(OLED_SCK, -1, OLED_MOSI, OLED_CS);
  if (!display.begin()) {
    Serial.println("OLED init FAILED");
    while (1) delay(100);
  }
  showOnOLED("Starting...");

  // Servos
  int pins[] = {SERVO1_PIN, SERVO2_PIN, SERVO3_PIN, SERVO4_PIN, SERVO5_PIN, SERVO6_PIN};
  for (int i = 0; i < 6; i++) {
    servo[i].setPeriodHertz(50);
    servo[i].attach(pins[i], 500, 2400);
    servo[i].write(servoAngles[i]);
  }

  // WiFi AP
  WiFi.mode(WIFI_AP);
  WiFi.setSleep(false);
  delay(500);
  WiFi.softAP(AP_SSID, AP_PASS, 1);
  WiFi.setTxPower(WIFI_POWER_8_5dBm);

  Serial.print("AP IP: ");
  Serial.println(WiFi.softAPIP());

  // Web server
  server.on("/", HTTP_GET, handleRoot);
  server.on("/", HTTP_POST, handlePost);
  server.begin();

  showOnOLED("Ready! 6 Servos");
}

void loop() {
  server.handleClient();
}
